{
  "name": "finance-dashboard",
  "productName": "Finance Dashboard",
  "version": "0.1.0",
  "description": "Local-first personal finance dashboard: your data stays on your machine.",
  "author": "Punter Digital Limited",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/PunterDigital/finance-dashboard.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/main.ts",
    "dev:client": "vite",
    "build": "npm run build:ui && npm run build:electron",
    "build:ui": "vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-electron/main.js --sourcemap",
    "start": "npm run build && electron .",
    "seed": "tsx server/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "papaparse": "^5.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "recharts": "^2.15.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
